{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="ru">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		{# Если используешь Symfony UX + Importmap, можно оставить как есть.
															   Если Webpack Encore — см. вариант ниже. #}
		{% block stylesheets %}
            <style>
                .turbo-progress-bar {
                    height: 5px;
                    background-color: red;
                }
            </style>

    {% endblock %}

    
    {% block javascripts %}
        {{ importmap('app') }}
            <script>
                {# {{ importmap('app') }} #}
                
               import "@hotwired/turbo";
                import confetti from "canvas-confetti";

document.addEventListener("turbo:load", () => {
  const el = document.querySelector("[data-confetti]");
  if (el) confetti();
});
            </script>

		{% endblock %}

	</head>
	<body>
		{{include('partials/_nav.html.twig')}}

		<hr>
		<main
			role="main">
			{# {% for message in app.flashes('success') %}
							<div></div>
						{% endfor %} #}
			{# {{include('partials/_flash_messages.html.twig')}} #}


			{% block body %}{% endblock %}
		</main>

	</body>
</html>
